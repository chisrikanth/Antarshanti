<!DOCTYPE html>
<html lang="{{ htmlLang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% include "partials/seo.njk" %}
{% include "partials/head-static.njk" %}
{% if lang and lang.fontsHref %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="{{ lang.fontsHref }}">
{% endif %}{% if razorpay %}<script src="https://checkout.razorpay.com/v1/checkout.js" defer></script>
{% endif %}{% if not ownCss %}<link rel="stylesheet" href="/assets/base.css">
{% endif %}{% if ownCss %}<link rel="stylesheet" href="/assets/checkin.css">
{% endif %}{% if extraCss %}<link rel="stylesheet" href="/assets/{{ extraCss }}">
{% endif %}<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/theme.css">
<script src="/assets/env.js"></script>
<script src="/assets/content.js"></script>
</head>
<body class="p-{{ navKey or 'x' }}">
<a class="skip-link" href="#main">{{ t.chrome.skip }}</a>
{% if not env.isProduction %}<div style="background:#2F2418;color:#FFE9CC;text-align:center;padding:6px 12px;font:600 12px/1.4 sans-serif;letter-spacing:.06em">TEST SITE · {{ env.context | upper }} · not the live website · no real payments · sample data</div>
{% endif %}{% block topbar %}{% endblock %}
{% block navigation %}{% include "partials/nav.njk" %}{% endblock %}
<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>
{% block footer %}{% include "partials/footer.njk" %}{% endblock %}
{% block mobilebar %}{% endblock %}
{% if not ownCss %}{% include "partials/nav-script.njk" %}{% endif %}
{% block scripts %}{% endblock %}
<script src="/assets/site.js" defer></script>
</body>
</html>
