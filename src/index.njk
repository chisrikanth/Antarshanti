---
pagination:
  data: languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
i18nKey: home
basePage: index
basePath: /
ldKey: "index"
navKey: "home"
---
{% extends "layouts/base.njk" %}
{% block topbar %}<div class="topbar" data-announce hidden></div>{% endblock %}
{% block mobilebar %}{% set c = t.home %}<div class="mobile-bar"><a class="btn btn-gold" href="#offerings">{{ c.mobileBar.explore }}</a><a class="btn btn-wa" href="https://wa.me/919985133161" target="_blank" rel="noopener">{{ c.mobileBar.whatsapp }}</a></div>{% endblock %}
{% block content %}{% set c = t.home %}
<header class="home-hero" style="position:relative;overflow:hidden;padding:46px 0 56px">
  <svg class="hero-deco" style="position:absolute;left:50%;top:-110px;margin-left:-360px;width:720px;height:720px;pointer-events:none;opacity:.38" viewBox="0 0 560 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g class="spin-el" style="transform-origin:280px 280px;animation:spin 240s linear infinite">
    <circle cx="280" cy="280" r="258" fill="none" stroke="rgba(217,164,65,.45)" stroke-width="1"/>
    <circle cx="280" cy="280" r="198" fill="none" stroke="rgba(217,164,65,.32)" stroke-width="1"/>
    <circle cx="280" cy="280" r="135" fill="none" stroke="rgba(217,164,65,.22)" stroke-width="1" stroke-dasharray="4 8"/>
    <g stroke="rgba(217,164,65,.38)" stroke-width="1">
      <line x1="280" y1="18" x2="280" y2="542"/><line x1="18" y1="280" x2="542" y2="280"/>
      <line x1="50" y1="147" x2="510" y2="413"/><line x1="50" y1="413" x2="510" y2="147"/>
      <line x1="147" y1="50" x2="413" y2="510"/><line x1="413" y1="50" x2="147" y2="510"/>
    </g>
    <g fill="rgba(184,64,106,.38)"><ellipse cx="280" cy="72" rx="7" ry="16"/><ellipse cx="280" cy="488" rx="7" ry="16"/><ellipse cx="72" cy="280" rx="16" ry="7"/><ellipse cx="488" cy="280" rx="16" ry="7"/></g>
    <g fill="rgba(217,107,16,.75)">
      <circle cx="280" cy="18" r="3.5"/><circle cx="542" cy="280" r="3.5"/><circle cx="280" cy="542" r="3.5"/><circle cx="18" cy="280" r="3.5"/>
      <circle cx="413" cy="50" r="2.5"/><circle cx="510" cy="147" r="2.5"/><circle cx="510" cy="413" r="2.5"/><circle cx="413" cy="510" r="2.5"/>
      <circle cx="147" cy="510" r="2.5"/><circle cx="50" cy="413" r="2.5"/><circle cx="50" cy="147" r="2.5"/><circle cx="147" cy="50" r="2.5"/>
    </g>
    <circle cx="280" cy="280" r="6" fill="rgba(217,107,16,.9)"/><circle cx="280" cy="280" r="2.5" fill="#FFF7EC"/>
  </g>
</svg>
  <div class="wrap hero-grid hero-intro" style="position:relative;z-index:2">
  <div>

    <div class="eyebrow" style="color:var(--saffron);margin-bottom:18px">{{ c.hero.eyebrow }}</div>
    <h1 style="font-size:clamp(2.4rem,5.5vw,3.8rem);max-width:620px">{{ c.hero.title | safe }}</h1>
    <p class="hero-attr">{{ c.hero.attr }}</p>
    <p style="font-size:1.1rem;color:var(--body);max-width:600px;margin:18px 0 0;line-height:1.75">
      {{ c.hero.intro | safe }}
    </p>
    <p class="hero-note">{{ c.hero.note }}</p>
    {% set pk = c.pick %}<div class="pick" data-pick data-suggested="{{ pk.suggested }}" data-r0="{{ pk.replies[0] }}" data-r1="{{ pk.replies[1] }}" data-r2="{{ pk.replies[2] }}" data-r3="{{ pk.replies[3] }}">
      <p class="pick-q" id="pickQ">{{ pk.q }}</p>
      <div class="pick-chips" role="group" aria-labelledby="pickQ">{% for ch in pk.chips %}<button type="button" class="pick-chip" data-i="{{ loop.index0 }}" aria-pressed="false">{{ ch }}</button>{% endfor %}</div>
      <p class="pick-reply" aria-live="polite"></p>
      <p class="pick-care" hidden>{{ t.checkin.js.crisis.skipped | safe }}</p>
      <div class="pick-actions" hidden>
        <button type="button" class="btn btn-gold btn-sm pick-show">{{ pk.show }}</button>
        <a class="btn btn-gold btn-sm pick-checkin" href="{{ 'checkin.html' | lhref(lang.code) }}">{{ t.chrome.nav.checkin }}</a>
        <button type="button" class="btn btn-outline btn-sm pick-look">{{ pk.look }}</button>
        <a class="btn btn-wa btn-sm pick-wa" href="https://wa.me/919985133161" target="_blank" rel="noopener">{{ t.chrome.whatsappSrikanth }}</a>
      </div>
    </div>
  </div>
</div>
<div id="offerings" class="wrap offerings-in-hero" style="position:relative;z-index:2;margin-top:52px">
  <div>
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px;text-align:center">{{ c.offerings.eyebrow }}</div>
    <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-bottom:8px;text-align:center">{{ c.offerings.title }}</h2>
    <p style="text-align:center;color:var(--dim);max-width:600px;margin:0 auto 36px;font-size:.97rem">{{ c.offerings.intro }}</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px">
      <a data-path="jyotish" href="{{ 'jyotish.html' | lhref(lang.code) }}" style="background:var(--card);border:1px solid var(--line);border-top:3px solid var(--saffron);border-radius:var(--radius);padding:28px 24px;display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;transition:box-shadow .2s,transform .2s" onmouseover="this.style.boxShadow='0 10px 30px rgba(138,59,18,.12)';this.style.transform='translateY(-3px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
        <div class="eyebrow" style="color:var(--saffron)">{{ c.offerings.jyotish.eyebrow }}</div>
        <h2 style="font-size:1.45rem">{{ c.offerings.jyotish.title }}</h2>
        <p style="font-size:.95rem;color:var(--body);line-height:1.7;flex:1">{{ c.offerings.jyotish.text }}</p>
        <span class="offer-ask">{{ c.offerings.jyotish.ask }}</span>
        <span class="btn btn-gold btn-sm" style="align-self:flex-start;margin-top:4px">{{ c.offerings.jyotish.btn }}</span>
      </a>
      <a data-path="bach" href="{{ 'bach.html' | lhref(lang.code) }}" style="background:var(--card);border:1px solid var(--line);border-top:3px solid var(--lotus);border-radius:var(--radius);padding:28px 24px;display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;transition:box-shadow .2s,transform .2s" onmouseover="this.style.boxShadow='0 10px 30px rgba(138,59,18,.12)';this.style.transform='translateY(-3px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
        <div class="eyebrow" style="color:var(--lotus)">{{ c.offerings.bach.eyebrow }}</div>
        <h2 style="font-size:1.45rem">{{ c.offerings.bach.title }}</h2>
        <p style="font-size:.95rem;color:var(--body);line-height:1.7;flex:1">{{ c.offerings.bach.text }}</p>
        <span class="offer-ask">{{ c.offerings.bach.ask | safe }}</span>
        <span class="btn btn-lotus btn-sm" style="align-self:flex-start;margin-top:4px">{{ c.offerings.bach.btn }}</span>
      </a>
      <a data-path="happiness" href="{{ 'happiness.html' | lhref(lang.code) }}" style="background:var(--card);border:1px solid var(--line);border-top:3px solid var(--leaf);border-radius:var(--radius);padding:28px 24px;display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;transition:box-shadow .2s,transform .2s" onmouseover="this.style.boxShadow='0 10px 30px rgba(138,59,18,.12)';this.style.transform='translateY(-3px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
        <div class="eyebrow" style="color:var(--leaf)">{{ c.offerings.happiness.eyebrow }}</div>
        <h2 style="font-size:1.45rem">{{ c.offerings.happiness.title }}</h2>
        <p style="font-size:.95rem;color:var(--body);line-height:1.7;flex:1">{{ c.offerings.happiness.text }}</p>
        <span class="offer-ask">{{ c.offerings.happiness.ask | safe }}</span>
        <span class="btn btn-leaf btn-sm" style="align-self:flex-start;margin-top:4px">{{ c.offerings.happiness.btn }}</span>
      </a>
    </div>
  </div>
</div>
</header>

<section class="checkin-band">
  <div class="wrap checkin-band-inner">
    <div>
      <div class="eyebrow" style="color:var(--saffron);margin-bottom:8px">{{ c.band.eyebrow }}</div>
      <h2>{{ c.band.title }}</h2>
      <p>{{ c.band.text }}</p>
    </div>
    <div class="band-actions">
      <a class="btn btn-gold" href="{{ 'checkin.html' | lhref(lang.code) }}">{{ c.band.btn }}</a>
      <a class="btn btn-wa" href="https://wa.me/919985133161?text={{ c.hero.waMessage | urlencode }}" target="_blank" rel="noopener">{{ t.chrome.whatsappSrikanth }}</a>
    </div>
  </div>
</section>

<section style="padding:56px 0">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:280px 1fr;gap:52px;align-items:center" class="two-col">
      <img src="/assets/srikanth.webp" width="280" height="280" loading="lazy" alt="{{ c.about.alt }}" style="width:100%;aspect-ratio:1/1;border-radius:50%;object-fit:cover;border:3px solid var(--gold);box-shadow:0 0 0 6px rgba(217,164,65,.15),0 14px 40px rgba(138,59,18,.16)">
      <div>
        <div class="eyebrow" style="color:var(--saffron);margin-bottom:12px">{{ c.about.eyebrow }}</div>
        <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);margin-bottom:18px">{{ c.about.title }}</h2>
        <p class="about-p">{{ c.about.p1 }}</p>
        <p class="about-p">{{ c.about.p2 | safe }}</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">{% for chip in c.about.chips %}
          <span style="border:1px solid var(--gold);border-radius:999px;padding:6px 15px;font-size:.8rem;letter-spacing:.04em;color:var(--copper);background:rgba(217,164,65,.1);font-weight:500">{{ chip }}</span>{% endfor %}
        </div>
        {% set hl = c.hello %}<div class="ig-hello" data-ig="DeHE_4VS2IG" data-title="{{ hl.title }}" data-play="{{ hl.play }}">
          <button type="button" class="ig-play" aria-label="{{ hl.play }}"><img src="/assets/srikanth.webp" width="64" height="64" loading="lazy" alt=""><span class="ig-glyph" aria-hidden="true"></span><span class="ig-words"><b>{{ hl.title }}</b><i>{{ hl.note }}</i></span></button>
          <a class="ig-open" href="https://www.instagram.com/p/DeHE_4VS2IG/" target="_blank" rel="noopener">{{ hl.open }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section data-hide-empty>
  <div class="wrap">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.kind.eyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:22px">{{ c.kind.title }}</h2>
    <div data-testimonials="home"></div>
  </div>
</section>

<div class="cta-strip cta-strip-center">
  <div class="cta-strip-inner">
    <div><p>{{ c.cta.title }}</p><span>{{ c.cta.text }}</span></div>
    <div class="cta-strip-btns">
      <a class="btn btn-gold btn-sm" href="{{ 'jyotish.html' | lhref(lang.code) }}#booking-widget">{{ c.cta.jyotish }}</a>
      <a class="btn btn-lotus btn-sm" href="{{ 'bach.html' | lhref(lang.code) }}">{{ c.cta.bach }}</a>
      <a class="btn btn-wa btn-sm" href="https://wa.me/919985133161" target="_blank">{{ t.chrome.whatsappSrikanth }}</a>
    </div>
  </div>
</div>

{% endblock %}
{% block scripts %}{% set c = t.home %}<script src="/assets/pick.js" defer></script><script src="/assets/ig.js" defer></script><script>
const NEXT_BATCH = {{ c.offerings.happiness.nextBatch | dump | safe }};
{% raw %}AS_READY.then(function(c){var e=document.getElementById('homeNextBatch');
  if(e&&c.batches.length){e.textContent=NEXT_BATCH.replace('{date}', AS_batchDate(c.batches[0]));}});
{% endraw %}</script>{% endblock %}
