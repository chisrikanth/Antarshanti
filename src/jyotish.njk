---
pagination:
  data: languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
i18nKey: jyotish
basePage: jyotish
basePath: /jyotish
ldKey: "jyotish"
navKey: "jyotish"
---
{% extends "layouts/base.njk" %}
{% block topbar %}{% set c = t.jyotish %}<div class="topbar">✦ {{ c.topbar.lead }} <a href="#booking-widget">{{ c.topbar.link }}</a> {{ c.topbar.tail }} ✦</div>{% endblock %}
{% block mobilebar %}{% set c = t.jyotish %}<div class="mobile-bar"><a class="btn btn-gold" href="#booking-widget">{{ c.mobileBar.book }}</a><a class="btn btn-wa" href="https://wa.me/919985133161" target="_blank" rel="noopener">{{ c.mobileBar.whatsapp }}</a></div>{% endblock %}
{% block content %}{% set c = t.jyotish %}{% set b = t.booking %}
<header style="position:relative;min-height:68vh;display:flex;align-items:center;overflow:hidden;padding:90px 0 70px;background:linear-gradient(160deg,#FFF7EC 0%,#FBEEDB 100%)">
  <svg class="hero-deco" style="position:absolute;right:-140px;top:50%;transform:translateY(-50%);width:560px;height:560px;pointer-events:none" viewBox="0 0 560 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g class="spin-el" style="transform-origin:280px 280px;animation:spin 240s linear infinite">
    <circle cx="280" cy="280" r="258" fill="none" stroke="rgba(217,164,65,.45)" stroke-width="1"/>
    <circle cx="280" cy="280" r="198" fill="none" stroke="rgba(217,164,65,.32)" stroke-width="1"/>
    <circle cx="280" cy="280" r="135" fill="none" stroke="rgba(217,164,65,.22)" stroke-width="1" stroke-dasharray="4 8"/>
    <g stroke="rgba(217,164,65,.38)" stroke-width="1">
      <line x1="280" y1="18" x2="280" y2="542"/><line x1="18" y1="280" x2="542" y2="280"/>
      <line x1="50" y1="147" x2="510" y2="413"/><line x1="50" y1="413" x2="510" y2="147"/>
      <line x1="147" y1="50" x2="413" y2="510"/><line x1="413" y1="50" x2="147" y2="510"/>
    </g>
    <g fill="rgba(184,64,106,.38)"><ellipse cx="280" cy="72" rx="7" ry="16"/><ellipse cx="280" cy="488" rx="7" ry="16"/><ellipse cx="72" cy="280" rx="16" ry="7"/><ellipse cx="488" cy="280" rx="16" ry="7"/></g>
    <g fill="rgba(217,107,16,.75)">
      <circle cx="280" cy="18" r="3.5"/><circle cx="542" cy="280" r="3.5"/><circle cx="280" cy="542" r="3.5"/><circle cx="18" cy="280" r="3.5"/>
      <circle cx="413" cy="50" r="2.5"/><circle cx="510" cy="147" r="2.5"/><circle cx="510" cy="413" r="2.5"/><circle cx="413" cy="510" r="2.5"/>
      <circle cx="147" cy="510" r="2.5"/><circle cx="50" cy="413" r="2.5"/><circle cx="50" cy="147" r="2.5"/><circle cx="147" cy="50" r="2.5"/>
    </g>
    <circle cx="280" cy="280" r="6" fill="rgba(217,107,16,.9)"/><circle cx="280" cy="280" r="2.5" fill="#FFF7EC"/>
  </g>
</svg>
  <div class="wrap" style="position:relative;z-index:2;max-width:580px">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:14px">{{ c.hero.eyebrow }}</div>
    <h1 style="font-size:clamp(2.4rem,5vw,3.6rem)">{{ c.hero.titleA }}<br><span style="color:var(--saffron)">{{ c.hero.titleB }}</span></h1>
    <p style="font-size:1.08rem;color:var(--body);max-width:500px;margin:18px 0 30px;line-height:1.78">{{ c.hero.intro }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn btn-gold" href="#booking-widget">{{ c.hero.btnBook }}</a>
      <a class="btn btn-outline" href="#what-is">{{ c.hero.btnWhat }}</a>
    </div>
  </div>
</header>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div><p>{{ c.strip.title }}</p><span>{{ c.strip.sub }}</span></div>
    <div class="cta-strip-btns"><a class="btn btn-gold btn-sm" href="#booking-widget">{{ c.strip.btn }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ c.strip.waMsg | urlencode }}" target="_blank">{{ c.strip.wa }}</a></div>
  </div>
</div>

<section id="what-is" class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.whatIs.eyebrow }}</div>
    <h2 style="font-size:clamp(1.8rem,3vw,2.4rem);margin-bottom:18px">{{ c.whatIs.title }}</h2>
    <p style="font-size:1rem;color:var(--body);max-width:700px;line-height:1.8;margin-bottom:34px">{{ c.whatIs.text | safe }}</p>
    <div class="vid-grid">
      <div class="vid wide" data-wide data-yt="caBLgExOBsQ" data-title="{{ c.whatIs.videos[0] }}"></div>
      <div class="vid" data-yt="zzRZGZv88n4" data-title="{{ c.whatIs.videos[1] }}"></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div style="display:grid;grid-template-columns:1.1fr 1fr;gap:32px;align-items:start" class="two-col">
      <div>
        <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.consult.eyebrow }}</div>
        <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);margin-bottom:22px">{{ c.consult.title }}</h2>
        <div class="offering-box">
          <div class="offering"><div><span class="o-name">{{ c.consult.name }}</span><span class="o-desc">{{ c.consult.desc }}</span></div></div>
        </div>
        <div class="contribute-note">
          <p class="ct-head">{{ c.consult.noFee }}</p>
          <p>{{ c.consult.gift1 }}</p>
          <p>{{ c.consult.gift2 }}</p>
        </div>
        <p style="font-size:.84rem;color:var(--dim);margin-top:12px">{{ c.consult.fine }}</p>
      </div>
      <div>
        {% set k = c.book %}
<div class="booking-box" id="booking-widget">
  <div class="booking-header" style="background:var(--saffron)">
    <h3>{{ b.headerTitle }}</h3>
    <p>{{ b.headerSub }}</p>
  </div>
  <div class="booking-body">
    <div class="session-tabs" id="stabs" style="display:none"></div>
    <div class="slots-label">{{ b.selectDate }}</div>
    <div class="week-nav"><button type="button" id="wk-prev" class="wk-btn" aria-label="{{ b.prevAria }}">{{ b.prevWeek }}</button><span id="wk-label" class="wk-label"></span><button type="button" id="wk-next" class="wk-btn" aria-label="{{ b.nextAria }}">{{ b.nextWeek }}</button></div>
    <div class="week-strip" id="week-strip"></div>
    <div class="slots-label" id="slots-label" style="display:none">{{ b.times }}</div>
    <div class="slots-grid" id="slots-grid"></div>
    <div class="booking-confirm" id="bconfirm">
      <p style="font-weight:700;color:var(--ink);font-size:.97rem;margin-bottom:8px">
        ✦ <span id="confirm-text"></span>
      </p>
      <div id="hold-form" class="hold-form">
        <p style="font-size:.88rem;color:var(--body);margin-bottom:10px">{{ k.holdIntro }}</p>
        <div class="field"><label for="h-name">{{ k.nameLabel }}</label><input type="text" id="h-name" autocomplete="name" maxlength="80"></div>
        <div class="field"><label for="h-phone">{{ k.phoneLabel }}</label><input type="tel" id="h-phone" autocomplete="tel" placeholder="{{ k.phonePh }}"></div>
        <input type="text" id="h-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0">
        <label class="consent-line"><input type="checkbox" id="h-consent"><span>{{ k.consent }}</span></label>
        <button type="button" class="btn btn-gold btn-sm" id="hold-btn" style="width:100%">{{ k.holdBtn }}</button>
        <div id="hold-status" class="hold-status" role="status"></div>
      </div>
      <div id="after-hold" style="display:none">
      <p style="font-size:.88rem;color:var(--body);margin-bottom:16px">{{ k.next }}</p>
      <ol class="steps3">
        <li><b>1</b><span>{{ k.steps[0] }}</span></li>
        <li><b>2</b><span>{{ k.steps[1] }}</span></li>
        <li><b>3</b><span>{{ k.steps[2] }}</span></li>
      </ol>
      <div class="pay-zone">
        <p class="pz-title">{{ k.payTitle }}</p>
        <p class="pz-sub">{{ k.paySub }}</p>
        <div class="pz-row">
          <img class="pz-qr" src="/assets/phonepe-qr.png" alt="{{ k.qrAlt }}" onerror="this.style.display='none'">
          <div class="pz-actions">
            <a id="wa-btn" class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ k.waMsgFirst | urlencode }}" target="_blank">{{ k.waBtn }}</a>
            <a id="upi-btn" class="btn btn-gold btn-sm" href="upi://pay?pa=chivukula.srikanth%40ybl&amp;pn=Antarshanti&amp;cu=INR">{{ k.upiBtn }}</a>
            <p class="pz-fine">{{ k.payFine }}</p>
          </div>
        </div>
      </div>
      </div>
    </div>
    <div class="availability-note">{{ b.availNote }}</div>
  </div>
</div>
<script src="/assets/booking.js"></script>
<script>var T = {{ b | dump | safe }}, K = {{ k | dump | safe }};</script>
{% raw %}<script>
(function(){
  ASBook.setT(T);
  var SLOTS = {"Mon": ["09:00 AM", "10:00 AM", "11:00 AM", "05:00 PM", "06:00 PM", "07:00 PM"], "Wed": ["09:00 AM", "10:00 AM", "11:00 AM", "05:00 PM", "06:00 PM", "07:00 PM"], "Fri": ["09:00 AM", "10:00 AM", "11:00 AM", "12:00 PM", "05:00 PM", "06:00 PM"], "Sat": ["09:00 AM", "10:00 AM", "11:00 AM", "03:00 PM", "04:00 PM", "05:00 PM"]};
  // ── Contribution model: no fixed fee. Set your UPI ID here. ──────────────
  var UPI_ID   = "chivukula.srikanth@ybl";   // e.g. srikanth@ybl
  var UPI_NAME = "Antarshanti";
  var sessions = [K.tabName];
  var selSession=sessions[0], selDay=null, selTime=null, slotText='';
  var tabsEl=document.getElementById('stabs');
  sessions.forEach(function(s){
    var b=document.createElement('button');
    b.className='stab'+(s===selSession?' active':'');
    b.textContent=s; b.onclick=function(){
      selSession=s; selDay=null; selTime=null;
      document.querySelectorAll('.stab').forEach(function(x){x.className='stab'});
      b.className='stab active';
      renderDays(); renderSlots();
      document.getElementById('bconfirm').className='booking-confirm';
    };
    tabsEl.appendChild(b);
  });
  // Build week strip (7 days per page, up to 6 weeks ahead)
  var weekOffset=0, MAX_WEEKS=6;
  function weekLabel(){
    var a=new Date(); a.setDate(a.getDate()+weekOffset*7); var b=new Date(a); b.setDate(a.getDate()+6);
    document.getElementById('wk-label').textContent=a.getDate()+' '+ASBook.monthName(a)+' – '+b.getDate()+' '+ASBook.monthName(b);
    document.getElementById('wk-prev').disabled=weekOffset===0;
    document.getElementById('wk-next').disabled=weekOffset>=MAX_WEEKS-1;
  }
  function gotoWeek(n){
    weekOffset=Math.max(0,Math.min(MAX_WEEKS-1,n)); selDay=null; selTime=null;
    document.getElementById('bconfirm').className='booking-confirm';
    renderDays(); renderSlots();
  }
  function renderDays(){
    var ws=document.getElementById('week-strip'); ws.innerHTML=''; weekLabel();
    var today=new Date();
    for(var i=0;i<7;i++){
      var d=new Date(today); d.setDate(today.getDate()+weekOffset*7+i);
      var avail=ASBook.dayHasFree(d,ASBook.timesFor(d,SLOTS));
      var btn=document.createElement('div');
      btn.className='day-btn'+(avail?'':' disabled')+(selDay&&selDay.toDateString()===d.toDateString()?' selected':'');
      btn.innerHTML='<div class="dname">'+ASBook.dayName(d)+'</div><div class="dnum">'+d.getDate()+'</div><div style="font-size:.7rem;color:inherit;opacity:.75">'+ASBook.monthName(d)+'</div>';
      (function(date,available){
        btn.onclick=function(){
          if(!available) return;
          selDay=date; selTime=null;
          renderDays(); renderSlots();
          document.getElementById('bconfirm').className='booking-confirm';
        };
      })(d,avail);
      ws.appendChild(btn);
    }
    if(!ws.querySelector('.day-btn:not(.disabled)')){
      var n=document.createElement('p'); n.style.cssText='font-size:.86rem;color:var(--dim);margin:10px 0 0;width:100%';
      var nextBtn='<button type="button" id="try-next-week" style="background:none;border:0;padding:0;font:inherit;color:#A04F14;text-decoration:underline;cursor:pointer">'+T.nextLink+'</button>';
      var waLnk='<a href="https://wa.me/919985133161?text='+encodeURIComponent(T.noTimesWaMsg)+'" target="_blank" rel="noopener" style="text-decoration:underline">'+T.waLink+'</a>';
      n.innerHTML=ASBook.fmt(T.noTimes,{next:nextBtn,wa:waLnk});
      ws.appendChild(n);
      var tn=document.getElementById('try-next-week'); if(tn) tn.onclick=function(){ gotoWeek(weekOffset+1); };
    }
  }
  function renderSlots(){
    var sg=document.getElementById('slots-grid');
    var sl=document.getElementById('slots-label');
    sg.innerHTML='';
    if(!selDay){ sl.style.display='none'; return; }
    var times=ASBook.timesFor(selDay,SLOTS);
    sl.style.display='block';
    sl.textContent=ASBook.fmt(T.timesFor,{date:ASBook.dateLabel(selDay)});
    times.forEach(function(t){
      var s=document.createElement('div');
      var st=ASBook.state(selDay,t);
      s.className='slot'+(t===selTime?' selected':'')+(st!=='free'?' taken':'');
      if(st==='taken') s.title=T.taken;
      s.textContent=t;
      s.onclick=st!=='free'?null:function(){
        selTime=t; renderSlots();
        if(window.AS) AS.track('slot_selected',{label:K.track});
        showConfirm();
      };
      sg.appendChild(s);
    });
  }
  function showConfirm(){
    if(!selDay||!selTime) return;
    slotText=ASBook.fmt(T.at,{date:ASBook.dateLabel(selDay),time:selTime});
    document.getElementById('confirm-text').textContent=ASBook.fmt(T.confirmLine,{session:selSession,slot:slotText});
    var u=document.getElementById('upi-btn');
    u.href='upi://pay?pa='+encodeURIComponent(UPI_ID)+'&pn='+encodeURIComponent(UPI_NAME)+'&cu=INR';
    document.getElementById('bconfirm').className='booking-confirm show';
    document.getElementById('hold-form').style.display='block';
    document.getElementById('after-hold').style.display='none';
    document.getElementById('hold-status').textContent='';
  }
  function holdSlot(){
    var st=document.getElementById('hold-status'), btn=document.getElementById('hold-btn');
    var name=document.getElementById('h-name').value.trim(), phone=document.getElementById('h-phone').value.trim();
    st.style.color='#C62828';
    if(name.length<2){ st.textContent=K.errName; return; }
    if(!/^\+?\d{10,13}$/.test(phone.replace(/[\s\-()]/g,''))){ st.textContent=K.errPhone; return; }
    if(!document.getElementById('h-consent').checked){ st.textContent=K.errConsent; return; }
    btn.disabled=true; btn.textContent=K.holding; st.textContent='';
    fetch('/.netlify/functions/reserve-slot',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({service:'jyotish_consultation',slot_start:ASBook.iso(selDay,selTime),name:name,phone:phone,consent:true,website:document.getElementById('h-website').value})})
    .then(function(r){ return r.json().then(function(j){ return {ok:r.ok,status:r.status,j:j}; }); })
    .then(function(x){
      btn.disabled=false; btn.textContent=K.holdBtn;
      if(x.ok){
        document.getElementById('confirm-text').textContent=ASBook.fmt(K.held,{slot:slotText});
        document.getElementById('hold-form').style.display='none';
        document.getElementById('after-hold').style.display='block';
        var w=document.getElementById('wa-btn');
        w.href='https://wa.me/919985133161?text='+encodeURIComponent(ASBook.fmt(K.waMsg,{name:name,slot:slotText}));
        w.removeAttribute('data-wa-tagged');
        if(window.AS) AS.track('slot_held',{label:K.track});
      } else {
        st.textContent=x.j&&x.j.error?x.j.error:K.failed;
        if(x.status===409){ selTime=null; document.getElementById('bconfirm').className='booking-confirm'; ASBook.load().then(function(d){ if(d&&d.rules){ SLOTS=ASBook.slotsFromRules(d.rules);} renderDays(); renderSlots(); }); }
      }
    }).catch(function(){ btn.disabled=false; btn.textContent=K.holdBtn; st.textContent=K.unreachable; });
  }
  document.getElementById('hold-btn').addEventListener('click',holdSlot);
  document.getElementById('wk-prev').addEventListener('click',function(){ gotoWeek(weekOffset-1); });
  document.getElementById('wk-next').addEventListener('click',function(){ gotoWeek(weekOffset+1); });
  renderDays(); renderSlots();
  ASBook.load().then(function(d){ if(d&&d.rules){ SLOTS=ASBook.slotsFromRules(d.rules); } renderDays(); renderSlots(); });
})();
</script>{% endraw %}
      </div>
    </div>
  </div>
</section>

<section data-hide-empty>
  <div class="wrap">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.testimonials.eyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:22px">{{ c.testimonials.title }}</h2>
    <div data-testimonials="jyotish"></div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.faqSection.eyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:22px">{{ c.faqSection.title }}</h2>
    {% include "partials/faq.njk" %}
  </div>
</section>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div><p>{{ c.cta.title }}</p><span>{{ c.cta.sub }}</span></div>
    <div class="cta-strip-btns"><a class="btn btn-gold btn-sm" href="#booking-widget">{{ c.cta.btn }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ c.cta.waMsg | urlencode }}" target="_blank">{{ c.cta.wa }}</a></div>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">{{ c.explore.eyebrow }}</div>
    <h2 style="font-size:1.7rem;margin-bottom:24px">{{ c.explore.title }}</h2>
    <div class="cross-grid">
      <a href="{{ 'bach.html' | lhref(lang.code) }}" class="cross-card">
        <div class="eyebrow" style="color:var(--lotus)">{{ c.explore.bach.eyebrow }}</div>
        <h3>{{ c.explore.bach.title }}</h3>
        <p>{{ c.explore.bach.text }}</p>
        <span class="btn btn-lotus btn-sm" style="margin-top:6px">{{ c.explore.bach.btn }}</span>
      </a>
      <a href="{{ 'happiness.html' | lhref(lang.code) }}" class="cross-card">
        <div class="eyebrow" style="color:var(--leaf)">{{ c.explore.happiness.eyebrow }}</div>
        <h3>{{ c.explore.happiness.title }}</h3>
        <p>{{ c.explore.happiness.text }}</p>
        <span class="btn btn-leaf btn-sm" style="margin-top:6px">{{ c.explore.happiness.btn }}</span>
      </a>
    </div>
  </div>
</section>
{% endblock %}
