---
pagination:
  data: languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
i18nKey: happiness
basePage: happiness
basePath: /happiness
ldKey: "happiness"
navKey: "happiness"
---
{% extends "layouts/base.njk" %}
{% block topbar %}{% set c = t.happiness %}<div class="topbar" style="background:var(--leaf)">✦ {{ c.topbar.text }} ✦</div>{% endblock %}
{% block mobilebar %}{% set c = t.happiness %}<div class="mobile-bar"><a class="btn btn-gold" href="#register">{{ c.mobileBar.register }}</a><a class="btn btn-wa" href="https://wa.me/919985133161" target="_blank" rel="noopener">{{ c.mobileBar.whatsapp }}</a></div>{% endblock %}
{% block content %}{% set c = t.happiness %}
<header style="position:relative;min-height:48vh;display:flex;align-items:center;overflow:hidden;padding:70px 0 56px;background:linear-gradient(160deg,#F7FAEE 0%,#EDFAE4 100%)">
  <svg class="hero-deco" style="position:absolute;right:40px;top:50%;transform:translateY(-50%);width:460px;height:460px;pointer-events:none;opacity:.65" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g class="spin-el" style="transform-origin:200px 200px;animation:spin 160s linear infinite">
    <circle cx="200" cy="200" r="178" fill="none" stroke="rgba(90,138,62,.4)" stroke-width="1"/>
    <circle cx="200" cy="200" r="128" fill="none" stroke="rgba(90,138,62,.28)" stroke-width="1" stroke-dasharray="5 10"/>
    <circle cx="200" cy="200" r="78" fill="none" stroke="rgba(90,138,62,.18)" stroke-width="1"/>
    <g stroke="rgba(90,138,62,.35)" stroke-width="1">
      <line x1="200" y1="20" x2="200" y2="380"/><line x1="20" y1="200" x2="380" y2="200"/>
      <line x1="74" y1="74" x2="326" y2="326"/><line x1="326" y1="74" x2="74" y2="326"/>
    </g>
    <g fill="rgba(90,138,62,.7)"><circle cx="200" cy="20" r="4"/><circle cx="380" cy="200" r="4"/><circle cx="200" cy="380" r="4"/><circle cx="20" cy="200" r="4"/></g>
    <g fill="rgba(217,164,65,.8)"><circle cx="326" cy="74" r="3"/><circle cx="326" cy="326" r="3"/><circle cx="74" cy="326" r="3"/><circle cx="74" cy="74" r="3"/></g>
  </g>
  <circle cx="200" cy="200" r="8" fill="rgba(90,138,62,.85)"/>
  <circle cx="200" cy="200" r="3.5" fill="#F7FAEE"/>
</svg>
  <div class="wrap" style="position:relative;z-index:2;max-width:580px">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:14px">{{ c.hero.eyebrow }}</div>
    <h1 style="font-size:clamp(2.4rem,5vw,3.6rem);color:var(--ink)">{{ c.hero.title | safe }}</h1>
    <p style="font-size:1.08rem;color:var(--body);max-width:500px;margin:18px 0 10px;line-height:1.78">{{ c.hero.intro | safe }}</p>
    {% set b = c.breathe %}<div class="breathe leaf" data-breathe data-pattern="4,4,6,2" data-gentle="4,6" data-rounds="3" data-unit="1000" data-t-in="{{ b.in }}" data-t-hold="{{ b.hold }}" data-t-out="{{ b.out }}" data-t-rest="{{ b.rest }}" data-t-label="{{ b.label }}" data-t-stop="{{ b.stop }}" data-t-done="{{ b.done }}" data-r0="{{ b.reply[0] }}" data-r1="{{ b.reply[1] }}" data-r2="{{ b.reply[2] }}">
      <div class="breathe-stage">
        <button type="button" class="breathe-orb" aria-label="{{ b.label }}" aria-describedby="breatheCap"><span class="b-art" aria-hidden="true"><i class="b-guide b-g-in"></i><i class="b-guide b-g-out"></i><i class="b-glow"></i><svg class="b-body" viewBox="-100 -100 200 200" focusable="false"><defs><radialGradient id="bBalloon" cx=".36" cy=".3" r=".78"><stop offset="0" stop-color="#F1F9E8"/><stop offset=".74" stop-color="#8DB27B"/></radialGradient></defs><path fill="url(#bBalloon)" d="M0-100A100 100 0 1 1 0 100A100 100 0 1 1 0-100Z"/></svg><i class="b-disc b-d-small"></i><i class="b-disc b-d-large"></i></span></button>
        <div class="breathe-text"><div class="breathe-cap" id="breatheCap" aria-live="polite">{{ b.label }}</div><p class="breathe-hint">{{ b.hint }}</p>
          <label class="breathe-opt"><input type="checkbox" class="breathe-gentle"> {{ b.skipHolds }}</label></div>
      </div>
      <div class="breathe-after" hidden>
        <p class="breathe-ask" id="breatheAsk">{{ b.ask }}</p>
        <div class="breathe-feels" role="group" aria-labelledby="breatheAsk">{% for f in b.feel %}<button type="button" class="breathe-chip" data-feel="{{ loop.index0 }}" aria-pressed="false">{{ f }}</button>{% endfor %}</div>
        <p class="breathe-reply" tabindex="-1" aria-live="polite"></p>
        <div class="breathe-ctas" hidden><a class="btn btn-leaf btn-sm breathe-register" href="#register">{{ b.ctaRegister }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ b.waMessage | urlencode }}" target="_blank" rel="noopener">{{ b.ctaWa }}</a></div>
      </div>
      <p class="breathe-note">{{ b.note }}</p>
    </div>
    <p style="font-size:.96rem;color:var(--dim);max-width:500px;margin:0 0 30px;line-height:1.7">{{ c.hero.about | safe }}</p>
  </div>
</header>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div><p>{{ c.strip.title }}</p><span>{{ c.strip.text }}</span></div>
    <div class="cta-strip-btns"><a class="btn btn-leaf btn-sm" href="#register">{{ c.strip.btnDates }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ c.strip.waMessage | urlencode }}" target="_blank">{{ c.strip.btnWa }}</a></div>
  </div>
</div>

<section id="what-is" class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.whatIs.eyebrow }}</div>
    <h2 style="font-size:clamp(1.8rem,3vw,2.4rem);margin-bottom:18px">{{ c.whatIs.title }}</h2>
    <p style="font-size:1rem;color:var(--body);max-width:700px;line-height:1.8;margin-bottom:34px">{{ c.whatIs.text }}</p>
    <div class="vid-grid">
      <div class="vid" data-yt="{{ c.whatIs.videoIds[0] }}" data-by="{{ c.whatIs.videoBy[0] }}" data-title="{{ c.whatIs.videos[0] }}" data-open="{{ c.whatIs.youtubeOpen }}"></div>
      <div class="vid" data-yt="{{ c.whatIs.videoIds[1] }}" data-by="{{ c.whatIs.videoBy[1] }}" data-title="{{ c.whatIs.videos[1] }}" data-open="{{ c.whatIs.youtubeOpen }}"></div>
      <div class="vid" data-yt="{{ c.whatIs.videoIds[2] }}" data-by="{{ c.whatIs.videoBy[2] }}" data-title="{{ c.whatIs.videos[2] }}" data-open="{{ c.whatIs.youtubeOpen }}"></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.learn.eyebrow }}</div>
    <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);margin-bottom:24px">{{ c.learn.title }}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px">{% for it in c.learn.items %}
      <div style="background:var(--card);border:1px solid var(--line);border-left:3px solid var(--leaf);border-radius:var(--radius);padding:18px 20px"><h4 role="heading" aria-level="3" style="font-size:1rem;margin-bottom:7px;color:var(--ink)">{{ it.title }}</h4><p style="font-size:.88rem;color:var(--body);line-height:1.65">{{ it.text }}</p></div>{% endfor %}
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.says.eyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:22px">{{ c.says.title }}</h2>
    <div data-testimonials="happiness"></div>
    <p style="font-size:.92rem;color:var(--dim);margin-top:16px" class="says-more">{{ c.says.more | safe }}</p>
  </div>
</section>

<section style="padding:56px 0;background:var(--paper-2);border-top:1px solid var(--line)">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.watch.eyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.1rem);margin-bottom:10px">{{ c.watch.title }}</h2>
    <p style="color:var(--dim);max-width:600px;font-size:.95rem">{{ c.watch.text }}</p>
    <div class="res-grid">
        <a class="res-card" href="https://www.youtube.com/playlist?list=PLoZ9lCw2MJU9x2vNGguZRB1giJwLscS1R" target="_blank" rel="noopener"><span class="res-kind">{{ c.watch.playlist.kind }}</span><span class="res-title">{{ c.watch.playlist.title }}</span><span class="res-desc">{{ c.watch.playlist.desc }}</span></a>
        <a class="res-card" href="https://www.youtube.com/@artofliving" target="_blank" rel="noopener"><span class="res-kind">{{ c.watch.channel.kind }}</span><span class="res-title">{{ c.watch.channel.title }}</span><span class="res-desc">{{ c.watch.channel.desc }}</span></a>
        <a class="res-card" href="https://www.artofliving.org/search/course" target="_blank" rel="noopener"><span class="res-kind">{{ c.watch.course.kind }}</span><span class="res-title">{{ c.watch.course.title }}</span><span class="res-desc">{{ c.watch.course.desc }}</span></a>
    </div>
  </div>
</section>

<section id="register">
  <div class="wrap">
    <div style="background:linear-gradient(140deg,#F7FAEE,#DFF2D8);border:1px solid rgba(90,138,62,.28);border-radius:var(--radius);padding:48px 44px;display:grid;grid-template-columns:1.3fr 1fr;gap:44px;align-items:center;box-shadow:0 8px 28px rgba(90,138,62,.1)" class="two-col">
      <div>
        <div class="eyebrow" style="color:var(--leaf);margin-bottom:12px">{{ c.register.eyebrow }}</div>
        <h2 style="font-size:2rem;color:var(--ink);margin-bottom:14px">{{ c.register.title }}</h2>
        <p style="color:var(--body);font-size:1rem;line-height:1.75;margin-bottom:10px">{{ c.register.text }}</p>
        <div id="batchList"></div>
        <p style="font-size:.86rem;color:var(--dim)">{{ c.register.fine }}</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:13px">
        <a class="btn btn-wa" href="https://wa.me/919985133161?text={{ c.register.waMessage | urlencode }}" target="_blank" style="text-align:center">{{ c.register.btnWa }}</a>
        <a class="btn btn-leaf" href="https://www.artofliving.org/search/course" target="_blank" rel="noopener" style="text-align:center">{{ c.register.btnFind }}</a>
      </div>
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.faqEyebrow }}</div>
    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:22px">{{ c.faqTitle }}</h2>
    {% include "partials/faq.njk" %}
  </div>
</section>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div><p>{{ c.cta.title }}</p><span>{{ c.cta.text }}</span></div>
    <div class="cta-strip-btns"><a class="btn btn-leaf btn-sm" href="#register">{{ c.cta.btnRegister }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ c.cta.waMessage | urlencode }}" target="_blank">{{ c.cta.btnWa }}</a></div>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="eyebrow" style="color:var(--leaf);margin-bottom:10px">{{ c.explore.eyebrow }}</div>
    <h2 style="font-size:1.7rem;margin-bottom:24px">{{ c.explore.title }}</h2>
    <div class="cross-grid">
      <a href="{{ 'jyotish.html' | lhref(lang.code) }}" class="cross-card">
        <div class="eyebrow" style="color:var(--saffron)">{{ c.explore.jyotish.eyebrow }}</div>
        <h3>{{ c.explore.jyotish.title }}</h3>
        <p>{{ c.explore.jyotish.text }}</p>
        <span class="btn btn-gold btn-sm" style="margin-top:6px">{{ c.explore.jyotish.btn }}</span>
      </a>
      <a href="{{ 'bach.html' | lhref(lang.code) }}" class="cross-card">
        <div class="eyebrow" style="color:var(--lotus)">{{ c.explore.bach.eyebrow }}</div>
        <h3>{{ c.explore.bach.title }}</h3>
        <p>{{ c.explore.bach.text }}</p>
        <span class="btn btn-lotus btn-sm" style="margin-top:6px">{{ c.explore.bach.btn }}</span>
      </a>
    </div>
  </div>
</section>


{% endblock %}
{% block scripts %}{% set c = t.happiness %}<script src="/assets/breathe.js" defer></script><script>
const T = {{ c.js | dump | safe }};
const LANG = '{{ lang.code }}';
window.AS_KNOWN = T.known;   // standard batch phrases (fee, time, mode) shown in the visitor's language
{% raw %}
/* Render batch cards from data/site.json (or Supabase) via assets/content.js */
const fmt = (s, v) => String(s).replace(/\{(\w+)\}/g, (m, k) => (v && v[k] !== undefined ? v[k] : m));
AS_READY.then(function(c){
  var AS_BATCHES=c.batches, el=document.getElementById('batchList'); if(!el) return;
  var WA='https://wa.me/919985133161?text=';
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  if(!AS_BATCHES.length){
    el.innerHTML='<div class="batch-card"><div class="b-date">'+esc(T.soonTitle)+'</div>'+
      '<div class="b-meta">'+esc(T.soonText)+'</div>'+
      '<a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+WA+encodeURIComponent(T.soonWa)+'">'+esc(T.soonBtn)+'</a></div>';
    return;
  }
  el.innerHTML='<div class="batch-grid">'+AS_BATCHES.map(function(b){
    var date=AS_batchDate(b), mode=AS_batchField(b,'mode'), time=AS_batchField(b,'time'), lang=AS_batchField(b,'language'), fee=AS_batchField(b,'fee');
    var wa=WA+encodeURIComponent(fmt(T.registerMsg,{date:date,mode:mode}));
    var cta=b.registerUrl?'<a class="btn btn-leaf btn-sm" style="background:var(--leaf);color:#FFF7EC" target="_blank" rel="noopener" href="'+esc(b.registerUrl)+'">'+esc(T.register)+'</a> <a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+wa+'">'+esc(T.askWa)+'</a>'
                         :'<a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+wa+'">'+esc(T.registerOnWa)+'</a>';
    return '<div class="batch-card"><div class="b-date">'+esc(date)+'</div><div class="b-meta">'+
      [time,mode,lang].filter(Boolean).map(esc).join(' · ')+'<br>'+
      (b.seats?esc(fmt(T.seats,{n:b.seats}))+' · ':'')+'<strong>'+esc(fee||T.feeDefault)+'</strong></div>'+cta+'</div>';
  }).join('')+'</div>';
});
{% endraw %}</script>{% endblock %}
