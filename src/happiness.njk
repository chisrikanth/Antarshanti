{% block scripts %}{% raw %}<script>
/* Render batch cards from data/site.json (or Supabase) via assets/content.js */
AS_READY.then(function(c){
  var AS_BATCHES=c.batches, el=document.getElementById('batchList'); if(!el) return;
  var WA='https://wa.me/919985133161?text=';
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  if(!AS_BATCHES.length){
    el.innerHTML='<div class="batch-card"><div class="b-date">Next batch announced soon</div>'+
      '<div class="b-meta">Join the WhatsApp list and you will hear the date, fee and seats first. Fee is shared up front, before you commit.</div>'+
      '<a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+WA+encodeURIComponent('Namaste Srikanth, please add me to the list for the next Happiness Program batch.')+'">Join the WhatsApp list</a></div>';
    return;
  }
  el.innerHTML='<div class="batch-grid">'+AS_BATCHES.map(function(b){
    var msg='Namaste Srikanth, I would like to register for the Happiness Program batch on '+b.date+' ('+b.mode+').';
    var wa=WA+encodeURIComponent(msg);
    var cta=b.registerUrl?'<a class="btn btn-leaf btn-sm" style="background:var(--leaf);color:#FFF7EC" target="_blank" rel="noopener" href="'+esc(b.registerUrl)+'">Register →</a> <a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+wa+'">Ask on WhatsApp</a>'
                         :'<a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="'+wa+'">Register on WhatsApp</a>';
    return '<div class="batch-card"><div class="b-date">'+esc(b.date)+'</div><div class="b-meta">'+
      [b.time,b.mode,b.language].filter(Boolean).map(esc).join(' · ')+'<br>'+
      (b.seats?esc(b.seats)+' seats · ':'')+'<strong>'+(b.fee?esc(b.fee):'Fee shared on WhatsApp')+'</strong></div>'+cta+'</div>';
  }).join('')+'</div>';
});
</script>{% endraw %}{% endblock %}
