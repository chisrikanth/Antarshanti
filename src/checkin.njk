{% extends "layouts/base.njk" %}
{% block topbar %}{% raw %}<div class="topbar">✦ A gentle self-reflection tool from Antarshanti Healing ✦</div>{% endraw %}{% endblock %}
{% block navigation %}{% include "partials/nav.njk" %}
{% raw %}<div class="talk-strip"><span>Prefer to talk it through?</span> <a href="https://wa.me/919985133161?text=Namaste+Srikanth,+I+am+doing+the+check-in+and+would+like+to+talk." target="_blank" rel="noopener" data-label="talk-strip">Chat with Srikanth on WhatsApp</a></div>{% endraw %}{% endblock %}
{% block content %}{% raw %}<section class="checkin-shell">
  <div class="narrow">

    <!-- CONSENT SCREEN -->
    <div class="screen active" id="screen-consent">
      <div class="card consent-card">
        <div class="eyebrow" style="color:var(--saffron);margin-bottom:10px">Screening Tool · Free &amp; Confidential</div>
        <h1 style="font-size:clamp(1.6rem,4vw,2.1rem);margin-bottom:14px">Free 5-Minute Wellbeing Check-In</h1>
        <p style="font-size:.98rem;color:var(--body)">Life can be exciting, overwhelming, confusing, and everything in between. This short questionnaire helps you pause and reflect on your emotional wellbeing — anxiety, mood, mindfulness, self-esteem, and how you handle emotions.</p>
        <div class="tag-row">
          <span class="tag">Mindfulness</span><span class="tag">Self-esteem</span><span class="tag">Worry and tension</span>
          <span class="tag">Feeling low</span><span class="tag">Emotional balance</span>
        </div>
        <ul class="notice-list">
          <li>This is a self-reflection tool, not a diagnostic instrument</li>
          <li>Takes about 4–5 minutes · 25 questions</li>
          <li>Your responses are kept confidential</li>
          <li>You may skip any question that makes you uncomfortable</li>
          <li>You may close this page at any time</li>
        </ul>
        <label class="consent-check">
          <input type="checkbox" id="consent-checkbox">
          <span>I agree to participate voluntarily in this self-reflection questionnaire. I understand this is for educational and self-awareness purposes only, and does not replace medical or psychological advice.</span>
        </label>
        <button class="btn btn-gold" id="btn-begin" disabled style="width:100%">Begin Check-In →</button>
      </div>
    </div>

    <!-- QUESTION SCREEN -->
    <div class="screen" id="screen-question">
      <div class="progress-wrap">
        <div class="progress-top">
          <span class="progress-domain" id="q-domain-label">Anxiety</span>
          <span class="progress-count" id="q-count-label">1 / 25</span>
        </div>
        <div class="progress-track"><div class="progress-fill" id="q-progress-fill" style="width:4%"></div></div>
      </div>
      <div class="card q-card">
        <div class="q-stem">Over the past two weeks, how often has this been true for you?</div>
        <div class="q-text" id="q-text">—</div>
        <div class="options" id="q-options"></div>
        <div class="q-nav">
          <span class="skip-link" id="btn-back">← Back</span>
          <span class="skip-link" id="btn-skip">Skip this question →</span>
        </div>
      </div>
    </div>

    <!-- RESULTS SCREEN -->
    <div class="screen" id="screen-results">
      <div id="crisis-slot"></div>

      <div class="card overall-card">
        <div class="eyebrow" style="color:var(--saffron);margin-bottom:8px">Your Wellbeing Snapshot</div>
        <div class="overall-title" id="overall-title">Calculating...</div>
        <div class="overall-label" id="overall-label"></div>
      </div>

      <div id="domain-results"></div>

      <div id="path-slot"></div>

      <details class="how-it-works"><summary>How are these worked out?</summary>
        <p>Each area has five questions, each scored 0 to 4 and added up (0 to 20). We group the total into four bands. The bands are a simple guide, inspired by the way common screening tools group scores. They are not clinically validated, they cover only the last two weeks, and a skipped question is never counted as zero. They cannot diagnose anything.</p>
      </details>

      <div class="disclaimer-box">
        This check-in is a self-reflection tool, not a diagnosis. If how you feel stays heavy or gets worse, please speak to a doctor or counsellor.
      </div>

      <div class="results-bottom">
      <div class="card save-card">
        <h3>Want Srikanth to look at your results?</h3>
        <p>Optional — share your name and WhatsApp number and he'll personally follow up with a note. Your details are kept confidential and stored only with your consent.</p>
        <div class="field"><label for="f-name">Name</label><input type="text" id="f-name" placeholder="Your name"></div>
        <div class="field"><label for="f-phone">WhatsApp number</label><input type="tel" id="f-phone" placeholder="+91 XXXXX XXXXX"></div>
        <div class="field"><label for="f-email">Email (optional)</label><input type="email" id="f-email" placeholder="you@example.com"></div>
        <button class="btn btn-gold" id="btn-save" style="width:100%">Save My Results</button>
        <div class="save-status" id="save-status"></div>
      </div>

      <div class="card talk-card" id="wa-row">
        <h3>Not sure where to start?</h3>
        <p>Talk to Srikanth on WhatsApp. He can help you choose between Sudarshan Kriya and Bach Flower remedies, or simply listen.</p>
        <a class="btn btn-wa" id="wa-alt" href="https://wa.me/919985133161?text=Namaste+Srikanth,+I+did+the+check-in+and+would+like+to+talk." target="_blank" rel="noopener">Talk to Srikanth on WhatsApp</a>
      </div>
      </div>
    </div>

  </div>
</section>

{% endraw %}{% endblock %}

{% block scripts %}{% raw %}<script>
/* ---------------------------------------------------------
   DATA
--------------------------------------------------------- */
const SECTIONS = [
  {
    key:'mindfulness', title:'Mindfulness', direction:'strength', color:'sky',
    items:[
      'Noticed small sensory details around you — light, sound, smell',
      'Paused before reacting instead of responding on autopilot',
      'Noticed your breath or body without trying to change it',
      'Did ordinary tasks — eating, walking, showering — with full attention',
      'Observed your emotions arise without being swept away by them'
    ]
  },
  {
    key:'selfEsteem', title:'Self-esteem', direction:'strength', color:'gold',
    items:[
      'Felt satisfied with who you are',
      'Felt confident in your own judgment and decisions',
      'Felt you handle challenges about as well as most people',
      'Felt worthy of respect and care, including your own',
      "Spoke to yourself with the same kindness you'd offer a friend"
    ]
  },
  {
    key:'anxiety', title:'Worry and tension', direction:'distress', color:'lotus',
    items:[
      'Felt nervous, worried or on edge',
      'Found it hard to switch off racing thoughts',
      'Felt your heart race or body tense for no clear reason',
      'Avoided a task or situation because it felt overwhelming',
      'Expected something to go wrong, even without evidence'
    ]
  },
  {
    key:'depression', title:'Feeling low', direction:'distress', color:'lotus', crisisIndex:4,
    items:[
      "Lost interest in things you'd usually enjoy",
      'Felt low, flat or hopeless',
      'Had noticeably low energy or motivation',
      'Struggled with sleep — too little or too much',
      "Had thoughts that life isn't worth living, or of hurting yourself"
    ]
  },
  {
    key:'emotionRegulation', title:'Emotional balance', direction:'strength', color:'leaf',
    items:[
      'Managed to calm yourself down once upset',
      'Understood what triggered a strong emotion, even after the fact',
      'Let a difficult feeling pass without acting on it impulsively',
      'Expressed what you felt in words rather than bottling it up',
      'Stayed steady in your responses even under emotional pressure'
    ]
  }
];

const OPTIONS = ['Never','Rarely','Sometimes','Often','Always']; // scored 0-4

// Flatten into a single question list, each tagged with its section
const QUESTIONS = [];
SECTIONS.forEach((sec, sIdx) => {
  sec.items.forEach((text, iIdx) => {
    QUESTIONS.push({ sectionIndex:sIdx, itemIndex:iIdx, sectionKey:sec.key, text });
  });
});

const answers = {}; // key: "sectionKey_itemIndex" -> 0-4 (or undefined if skipped)
let currentQ = 0;

/* ---------------------------------------------------------
   NAVIGATION
--------------------------------------------------------- */
const screens = {
  consent: document.getElementById('screen-consent'),
  question: document.getElementById('screen-question'),
  results: document.getElementById('screen-results')
};
function showScreen(name){
  Object.values(screens).forEach(s => s.classList.remove('active'));
  screens[name].classList.add('active');
  window.scrollTo({top:0, behavior:'smooth'});
}

const consentBox = document.getElementById('consent-checkbox');
const beginBtn = document.getElementById('btn-begin');
consentBox.addEventListener('change', () => { beginBtn.disabled = !consentBox.checked; });
beginBtn.addEventListener('click', () => { currentQ = 0; renderQuestion(); showScreen('question'); if(window.AS) AS.track('checkin_started'); });

function answerKey(q){ return q.sectionKey + '_' + q.itemIndex; }

function renderQuestion(){
  const q = QUESTIONS[currentQ];
  const sec = SECTIONS[q.sectionIndex];
  document.getElementById('q-domain-label').textContent = sec.title;
  document.getElementById('q-count-label').textContent = (currentQ+1) + ' / ' + QUESTIONS.length;
  document.getElementById('q-progress-fill').style.width = Math.round(((currentQ+1)/QUESTIONS.length)*100) + '%';
  document.getElementById('q-text').textContent = q.text;

  const key = answerKey(q);
  const existing = answers[key];

  const optWrap = document.getElementById('q-options');
  optWrap.innerHTML = '';
  OPTIONS.forEach((label, val) => {
    const div = document.createElement('div');
    div.className = 'opt' + (existing === val ? ' selected' : '');
    div.innerHTML = '<span>'+label+'</span><span class="odot"></span>';
    div.addEventListener('click', () => {
      answers[key] = val;
      goNext();
    });
    optWrap.appendChild(div);
  });

  document.getElementById('btn-back').style.visibility = currentQ === 0 ? 'hidden' : 'visible';
}

function goNext(){
  if(currentQ < QUESTIONS.length - 1){
    currentQ++;
    renderQuestion();
  } else {
    computeAndRenderResults();
    showScreen('results');
    if(window.AS) AS.track('checkin_completed', { crisis: lastComputed.crisisFlag ? 1 : 0, path: lastComputed.path });
  }
}

document.getElementById('btn-back').addEventListener('click', () => {
  if(currentQ > 0){ currentQ--; renderQuestion(); }
});
document.getElementById('btn-skip').addEventListener('click', () => { goNext(); });

/* ---------------------------------------------------------
   SCORING
--------------------------------------------------------- */
function scoreDomain(sec){
  let sum = 0, answeredCount = 0;
  sec.items.forEach((_, i) => {
    const v = answers[sec.key + '_' + i];
    if(v !== undefined){ sum += v; answeredCount++; }
  });
  // Each area has 5 questions scored 0-4, so a total is 0-20. A skipped question is never counted as 0:
  // with 4 of 5 answered we scale up proportionally; with fewer we do not show that area at all.
  const raw = answeredCount >= 4 ? Math.round(sum / answeredCount * 5) : null;
  const percent = raw === null ? null : Math.round(raw / 20 * 100);   // kept only for saved data + path suggestion
  return { sum: raw, percent, answeredCount };
}

// Four gentle bands per area. Inspired by the proportions used in common screening tools (e.g. GAD-7, PHQ-9),
// but NOT a clinically validated scale. They describe the last two weeks only.
const BANDS = {
  distress: [
    { max:4,  label:'Doing well',            note:'You have felt little of this over the past two weeks. That is good to see.', color:'var(--leaf)' },
    { max:9,  label:'A little now and then', note:'Some days have felt tense or low. That is common and often passes.', color:'var(--gold)' },
    { max:14, label:'Showing up often',      note:'This has been with you quite a bit lately. Looking after yourself and talking it through can help.', color:'var(--saffron)' },
    { max:20, label:'Heavy right now',       note:'This has been weighing on you a lot lately. Talking to a doctor or counsellor is a good step, and you do not have to manage it alone.', color:'var(--lotus)' }
  ],
  strength: [
    { max:4,  label:'Just beginning',        note:'A good place to start. Small daily practices can help this grow.', color:'var(--gold)' },
    { max:9,  label:'Growing',               note:'You already have some of this to build on.', color:'var(--sky)' },
    { max:14, label:'Steady',                note:'This is a dependable part of how you cope.', color:'var(--leaf)' },
    { max:20, label:'A real strength',       note:'One of your clear strengths. Keep nurturing it.', color:'var(--leaf)' }
  ]
};
function bandFor(direction, raw){
  const list = BANDS[direction === 'distress' ? 'distress' : 'strength'];
  const i = list.findIndex(b => raw <= b.max);
  return { ...list[i], index: i, steps: i + 1 };
}

function barColor(colorName){
  const map = { lotus:'var(--lotus)', sky:'var(--sky)', gold:'var(--gold)', leaf:'var(--leaf)', saffron:'var(--saffron)' };
  return map[colorName] || 'var(--saffron)';
}

let lastComputed = null;

function computeAndRenderResults(){
  const domainScores = SECTIONS.map(sec => ({ sec, ...scoreDomain(sec) }));

  // crisis check
  const depSection = SECTIONS.find(s => s.crisisIndex !== undefined);
  const crisisVal = answers[depSection.key + '_' + depSection.crisisIndex];
  const crisisFlag = crisisVal !== undefined && crisisVal >= 1;

  const overall = null;   // no single number is shown or stored: a 0-100 figure for a mental state is misleading

  lastComputed = { domainScores, crisisFlag, overall };
  lastComputed.path = renderPathSuggestion(domainScores, crisisFlag, crisisVal);

  // -- crisis box --
  const crisisSlot = document.getElementById('crisis-slot');
  crisisSlot.innerHTML = '';
  if(crisisFlag){
    const box = document.createElement('div');
    box.className = 'crisis-box';
    box.innerHTML = `
      <h3>You don't have to carry this alone</h3>
      <p>One of your answers suggests you may be having a very hard time right now. Please talk to someone today. Tele-MANAS is the Government of India's free, confidential helpline.</p>
      <div class="helpline-main">
        <div><span class="hname">Tele-MANAS · Government of India</span><span class="hnum">14416</span><span class="havail">Free · 24 hours · many languages</span></div>
        <a class="btn btn-gold btn-sm" href="tel:14416">Call 14416</a>
      </div>
      <p class="crisis-small">More information: <a href="https://telemanas.mohfw.gov.in" target="_blank" rel="noopener">telemanas.mohfw.gov.in</a>. If you are in immediate danger, call 112 or go to your nearest hospital. Please also consider speaking with a qualified doctor.</p>
    `;
    crisisSlot.appendChild(box);
  }

  // -- snapshot message (words, not a number): what is going well first, then what needs care, truthfully --
  const shown = domainScores.filter(d => d.sum !== null);
  const isCare = d => d.sec.direction === 'distress' ? d.sum >= 10 : d.sum < 5;
  const isGood = d => d.sec.direction === 'distress' ? d.sum <= 4 : d.sum >= 10;
  const care = shown.filter(isCare).length, good = shown.filter(isGood).length;
  const heavy = shown.some(d => d.sec.direction === 'distress' && d.sum >= 15);
  const titleEl = document.getElementById('overall-title'), labelEl = document.getElementById('overall-label');
  const nArea = n => n === 1 ? 'one area' : n + ' areas';
  if(!shown.length){
    titleEl.textContent = 'Not enough answers for a snapshot';
    labelEl.textContent = 'If you would like, go back and answer a few more questions. You can skip any you prefer.';
  } else if(care === 0){
    titleEl.textContent = 'Things look steady right now';
    labelEl.textContent = 'This is a snapshot of the last two weeks. A good time to keep doing what works for you.';
  } else if(care >= 3 || heavy){
    titleEl.textContent = (good > 0 ? 'Some things are going well, and ' + nArea(care) + ' ' + (care === 1 ? 'is' : 'are') + ' asking for care' : 'Several areas are asking for some care right now');
    labelEl.textContent = 'That is worth some attention, and it is also very common. You do not have to handle it alone: talking with someone can make it feel lighter.';
  } else {
    titleEl.textContent = (good > 0 ? 'Some things are going well, and ' + nArea(care) + ' could use some care' : nArea(care).replace(/^o/, 'O') + ' could use some care');
    labelEl.textContent = 'That is common, and it is a snapshot of the last two weeks, not a verdict.';
  }
  // If the safety question was skipped, still make sure help is visible.
  if(!crisisFlag && crisisVal === undefined){
    const n = document.createElement('p'); n.className = 'crisis-small'; n.style.margin = '0 0 18px';
    n.innerHTML = 'If things ever feel too heavy, Tele-MANAS (<a href="tel:14416">14416</a>) is free, confidential and open 24 hours.';
    crisisSlot.appendChild(n);
  }

  // -- domain rows --
  const domainWrap = document.getElementById('domain-results');
  domainWrap.innerHTML = '';
  // Positive first: inner resources, then how you have been feeling.
  const groups = [
    { head:'Your inner resources', list: domainScores.filter(d => d.sec.direction === 'strength') },
    { head:'How you have been feeling', list: domainScores.filter(d => d.sec.direction === 'distress') }
  ];
  groups.forEach(g => {
    const col = document.createElement('div'); col.className = 'result-col'; domainWrap.appendChild(col);
    const h = document.createElement('h4'); h.className = 'result-group'; h.textContent = g.head; col.appendChild(h);
    g.list.forEach(d => {
      const row = document.createElement('div');
      row.className = 'domain-row';
      if(d.sum === null){
        row.innerHTML = `<div class="domain-top"><span class="domain-name">${d.sec.title}</span></div><div class="domain-note">Not enough answers to show this area. That is fine, you can skip anything you prefer.</div>`;
        col.appendChild(row); return;
      }
      const band = bandFor(d.sec.direction, d.sum);
      const steps = [0,1,2,3].map(i => `<i style="${i < band.steps ? 'background:'+band.color : ''}"></i>`).join('');
      row.innerHTML = `
        <div class="domain-top">
          <span class="domain-name">${d.sec.title}</span>
          <span class="domain-band" style="background:${band.color}22;color:var(--ink)">${band.label}</span>
        </div>
        <div class="steps4" role="img" aria-label="${band.label}, step ${band.steps} of 4">${steps}</div>
        <div class="domain-note">${band.note}</div>
      `;
      col.appendChild(row);
    });
  });
}

/* ---------------------------------------------------------
   PATH SUGGESTION — a gentle pointer, never a diagnosis.
   stress/energy -> Happiness Program; emotional heaviness -> Bach;
   steady + looking for direction/timing -> Jyotish.
--------------------------------------------------------- */
const NEXT = {
  sky:{ name:'Sudarshan Kriya', sub:'A breathing practice, taught in the Art of Living Happiness Program', url:'happiness.html#register', cta:'See the next Happiness Program', path:'happiness',
    yt:'gWwhIPAajfw', ytTitle:'What Sudarshan Kriya is',
    body:'Sudarshan Kriya is a rhythmic breathing practice. Several published studies report lower stress and anxiety after learning it, and many people simply find it deeply relaxing.' },
  bach:{ name:'Bach Flower remedies', sub:'A gentle, one-to-one approach', url:'bach.html#booking-widget', cta:'Book a Bach Flower session', path:'bach',
    yt:'Cm5DVzkOo_U', ytTitle:'Which Bach Flower remedy is right for you?',
    body:'Bach Flower remedies are a gentle, personalised approach that many people use to support their mood and emotional balance. Srikanth matches them to how you have been feeling.' },
  jyotish:{ name:'a Jyotish conversation', url:'jyotish.html#booking-widget' }
};
const INTRO = {
  stress:'Your answers point to some tension and a busy mind. If it stays heavy or starts to affect daily life, please see a doctor or counsellor. Alongside that, a breathing practice can be a good support.',
  heavy:'Your answers point to some emotional heaviness. If it stays heavy or starts to affect daily life, please see a doctor or counsellor. Alongside that, a gentle one-to-one approach can be a good support.',
  steady:'Your answers look steady. A simple daily breathing practice is a lovely way to keep it that way.'
};
function suggestLead(domainScores){
  const pct = {};
  domainScores.forEach(d => { pct[d.sec.key] = d.percent; });
  const answered = domainScores.filter(d => d.percent !== null).length;
  if(!answered) return null;
  const v = (k, dflt) => pct[k] === null || pct[k] === undefined ? dflt : pct[k];
  const stress = v('anxiety',0)*0.6 + (100 - v('mindfulness',50))*0.4;
  const heavy  = v('depression',0)*0.4 + (100 - v('emotionRegulation',50))*0.3 + (100 - v('selfEsteem',50))*0.3;
  // same rule as the snapshot message: nothing in a 'care' band means steady
  const care = domainScores.filter(d => d.sum !== null && (d.sec.direction === 'distress' ? d.sum >= 10 : d.sum < 5)).length;
  if(care === 0) return 'steady';
  return stress >= heavy ? 'stress' : 'heavy';
}
const waLink = (msg) => 'https://wa.me/919985133161?text=' + encodeURIComponent(msg);
const WA_TALK = waLink('Namaste Srikanth, I did the check-in and would like to talk.');
function optionCard(o, key, primary){
  return '<div class="card next-step '+(primary ? 'primary' : '')+'">' +
    '<div class="vid" data-yt="'+o.yt+'" data-title="'+o.ytTitle+'"></div>' +
    '<div><h3>'+o.name+'</h3><div class="ns-sub">'+o.sub+'</div><p>'+o.body+'</p>' +
    '<a class="btn btn-gold btn-sm" href="'+o.url+'" data-label="next:'+key+'">'+o.cta+' →</a></div></div>';
}
function renderPathSuggestion(domainScores, crisisFlag, crisisVal){
  const slot = document.getElementById('path-slot');
  const waAlt = document.getElementById('wa-alt');
  slot.innerHTML = '';
  if(crisisFlag && crisisVal >= 3){
    // Often / Always on the safety question: support first. No programme cards here, only a human to talk to.
    slot.innerHTML = '<div class="card path-primary"><h3>Whenever you feel ready</h3><p>Srikanth is happy to listen on WhatsApp. Please keep a doctor or counsellor in the loop too. When you feel steadier, he can also tell you about gentle supports such as a breathing practice or Bach Flower remedies.</p><a class="btn btn-wa btn-sm" target="_blank" rel="noopener" data-label="talk-crisis" href="'+WA_TALK+'">Talk to Srikanth on WhatsApp</a></div>';
    return 'support';
  }
  const lead = suggestLead(domainScores);
  if(!lead) return null;
  const primaryKey = lead === 'heavy' ? 'bach' : 'sky';
  const otherKey = primaryKey === 'sky' ? 'bach' : 'sky';
  const secondLine = lead === 'steady'
    ? 'Thinking about direction or timing? <a href="'+NEXT.jyotish.url+'" data-label="next:jyotish">A Jyotish conversation</a> can help. Or <a href="'+NEXT.bach.url+'" data-label="next:bach">Bach Flower remedies</a> if you would like extra emotional support.'
    : 'Many people try both: <a href="'+NEXT[otherKey].url+'" data-label="next:'+otherKey+'">'+NEXT[otherKey].name+'</a> works well alongside '+NEXT[primaryKey].name+'.';
  slot.innerHTML =
    '<div class="path-wrap"><div class="eyebrow" style="color:var(--saffron);margin-bottom:8px">A good next step</div>' +
    '<p class="ns-intro">'+INTRO[lead]+'</p>' + optionCard(NEXT[primaryKey], primaryKey, true) +
    '<p class="path-also">'+secondLine+'</p></div>';
  if(window.AS && AS.initVideos) AS.initVideos();
  waAlt.href = waLink('Namaste Srikanth, I did the check-in. ' + NEXT[primaryKey].name + ' was suggested for me and I would like to talk about it.');
  waAlt.removeAttribute('data-wa-tagged');
  return NEXT[primaryKey].path;
}

/* ---------------------------------------------------------
   SAVE TO DATABASE (Netlify function -> Supabase)
--------------------------------------------------------- */
document.getElementById('btn-save').addEventListener('click', async () => {
  const statusEl = document.getElementById('save-status');
  const btn = document.getElementById('btn-save');
  const name = document.getElementById('f-name').value.trim();
  const phone = document.getElementById('f-phone').value.trim();
  const email = document.getElementById('f-email').value.trim();

  if(!phone && !email){
    statusEl.textContent = 'Please share at least a WhatsApp number or email so Srikanth can reach you.';
    statusEl.className = 'save-status show err';
    return;
  }
  if(!lastComputed){
    statusEl.textContent = 'Please complete the check-in first.';
    statusEl.className = 'save-status show err';
    return;
  }

  const payload = {
    name: name || null,
    phone: phone || null,
    email: email || null,
    consent: true,
    crisisFlag: lastComputed.crisisFlag,
    overallScore: lastComputed.overall,
    domainScores: lastComputed.domainScores.reduce((acc, d) => {
      acc[d.sec.key] = { score: d.sum, percent: d.percent };
      return acc;
    }, {}),
    rawAnswers: answers,
    suggestedPath: lastComputed.path || null,
    attribution: window.AS ? AS.attribution() : {},
    submittedAt: new Date().toISOString()
  };

  btn.disabled = true;
  btn.textContent = 'Saving...';
  try {
    const res = await fetch('/.netlify/functions/submit-checkin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if(!res.ok) throw new Error('Save failed');
    statusEl.textContent = "Saved — Srikanth will follow up with you personally.";
    statusEl.className = 'save-status show ok';
    btn.textContent = 'Saved ✓';
    if(window.AS) AS.track('checkin_saved', { path: lastComputed.path || '' });
  } catch(err){
    console.error(err);
    statusEl.textContent = "Couldn't save right now, but your reflection above is still yours — feel free to screenshot it or message it on WhatsApp.";
    statusEl.className = 'save-status show err';
    btn.disabled = false;
    btn.textContent = 'Try Again';
  }
});
</script>{% endraw %}{% endblock %}
