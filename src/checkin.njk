        <a href="index.html" style="font-family:'Marcellus',serif;font-size:1.1rem;color:var(--ink)">Antar<em style="font-style:normal;color:var(--saffron)">shanti</em> Healing</a>
        <p style="font-size:.84rem;color:var(--dim);margin-top:8px">Srikanth · Hyderabad, India</p>
