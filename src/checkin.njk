permalink: "/checkin.html"
path: "/checkin"
title: "Free 5-Minute Emotional Wellbeing Check-In | Antarshanti Healing"
description: "A free, private 5-minute reflection on stress, mood, mindfulness, self-esteem and emotional balance, with a gentle suggestion of what may help. Not a diagnosis."
extraCss: "checkin-only.css"
navKey: "checkin"
