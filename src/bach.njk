    <p style="font-size:1rem;color:var(--body);max-width:700px;line-height:1.8;margin-bottom:34px">{{ c.whatIs.text }}</p>
    <div class="vid-grid">
      <div class="vid" data-yt="Cm5DVzkOo_U" data-title="{{ c.whatIs.videos[0] }}"></div>
      <div class="vid" data-yt="FafMg6pU8P8" data-title="{{ c.whatIs.videos[1] }}"></div>
      <div class="vid" data-yt="9wa5HW0rRoY" data-title="{{ c.whatIs.videos[2] }}"></div>
    </div>
