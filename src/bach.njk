    <g transform="translate(148,235)"><circle r="5" fill="#D9A441"/><g fill="rgba(155,120,200,.75)"><ellipse cx="0" cy="-12" rx="5" ry="8"/><ellipse cx="11" cy="-3" rx="8" ry="5"/><ellipse cx="7" cy="10" rx="6" ry="7"/><ellipse cx="-7" cy="10" rx="6" ry="7"/><ellipse cx="-11" cy="-3" rx="8" ry="5"/></g></g>
    <g transform="translate(270,283)"><circle r="5" fill="#E8761E"/><g fill="rgba(255,225,160,.9)"><ellipse cx="0" cy="-12" rx="5" ry="8"/><ellipse cx="11" cy="-3" rx="8" ry="5"/><ellipse cx="7" cy="10" rx="6" ry="7"/><ellipse cx="-7" cy="10" rx="6" ry="7"/><ellipse cx="-11" cy="-3" rx="8" ry="5"/></g></g>
    <g transform="translate(133,293)"><circle r="4" fill="#D9A441"/><g fill="rgba(184,64,106,.6)"><ellipse cx="0" cy="-10" rx="4" ry="7"/><ellipse cx="9" cy="-2.5" rx="7" ry="4"/><ellipse cx="5.5" cy="8" rx="5" ry="6"/><ellipse cx="-5.5" cy="8" rx="5" ry="6"/><ellipse cx="-9" cy="-2.5" rx="7" ry="4"/></g></g>
    <g transform="translate(260,313)"><circle r="4" fill="#D9A441"/><g fill="rgba(200,160,220,.7)"><ellipse cx="0" cy="-10" rx="4" ry="7"/><ellipse cx="9" cy="-2.5" rx="7" ry="4"/><ellipse cx="5.5" cy="8" rx="5" ry="6"/><ellipse cx="-5.5" cy="8" rx="5" ry="6"/><ellipse cx="-9" cy="-2.5" rx="7" ry="4"/></g></g>
  </g>
</svg>
  <div class="wrap" style="position:relative;z-index:2;max-width:560px">
    <div class="eyebrow" style="color:var(--lotus);margin-bottom:14px">{{ c.hero.eyebrow }}</div>
    <h1 style="font-size:clamp(2.4rem,5vw,3.6rem)">{{ c.hero.titleA }}<br><span style="color:var(--lotus)">{{ c.hero.titleB }}</span></h1>
    <p style="font-size:1.08rem;color:var(--body);max-width:500px;margin:18px 0 30px;line-height:1.78">{{ c.hero.intro }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn btn-lotus" href="#booking-widget">{{ c.hero.btnBook }}</a>
      <a class="btn btn-outline" href="#what-is">{{ c.hero.btnWhat }}</a>
    </div>
  </div>
</header>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div><p>{{ c.strip.title }}</p><span>{{ c.strip.sub | replace('{price}', P) | safe }}</span></div>
    <div class="cta-strip-btns"><a class="btn btn-lotus btn-sm" href="#booking-widget">{{ c.strip.btn }}</a><a class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ c.strip.waMsg | urlencode }}" target="_blank">{{ c.strip.wa }}</a></div>
  </div>
</div>

<section id="what-is" class="alt">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--lotus);margin-bottom:10px">{{ c.whatIs.eyebrow }}</div>
