---
pagination:
  data: languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
i18nKey: bach
basePage: bach
basePath: /bach
razorpay: true
ldKey: "bach"
navKey: "bach"
---
{% extends "layouts/base.njk" %}
{% block topbar %}{% set c = t.bach %}{% set P = '<span data-price="bach_consultation">₹1,000</span>' %}<div class="topbar" style="background:var(--lotus)">✦ {{ c.topbar.lead }} <a href="#booking-widget" style="color:#FFD8E8">{{ c.topbar.link | replace('{price}', P) | safe }}</a> {{ c.topbar.tail }} ✦</div>{% endblock %}
{% block mobilebar %}{% set c = t.bach %}<div class="mobile-bar"><a class="btn btn-gold" href="#booking-widget">{{ c.mobileBar.book }}</a><a class="btn btn-wa" href="https://wa.me/919985133161" target="_blank" rel="noopener">{{ c.mobileBar.whatsapp }}</a></div>{% endblock %}
{% block content %}{% set c = t.bach %}{% set b = t.booking %}{% set k = c.book %}{% set P = '<span data-price="bach_consultation">₹1,000</span>' %}
