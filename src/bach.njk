<script>
(function(){
  var SLOTS = {"Mon": ["09:00 AM", "10:00 AM", "11:00 AM", "05:00 PM", "06:00 PM", "07:00 PM"], "Wed": ["09:00 AM", "10:00 AM", "11:00 AM", "05:00 PM", "06:00 PM", "07:00 PM"], "Fri": ["09:00 AM", "10:00 AM", "11:00 AM", "12:00 PM", "05:00 PM", "06:00 PM"], "Sat": ["09:00 AM", "10:00 AM", "11:00 AM", "03:00 PM", "04:00 PM", "05:00 PM"]};
  // ── Razorpay. Key ID is public and safe here. The SECRET goes only in
  //    Netlify env vars (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET). ───────────
  var RAZORPAY_KEY_ID = "rzp_live_TZpURxGvndampZ";  // live Key ID (public); the secret stays in Netlify
  var AMOUNTS = {"Bach Flower Consultation": 0};  // names only; the PRICE is set on the server (services table)
  function currentPrice(){ return (window.AS_CONTENT&&AS_CONTENT.prices&&AS_CONTENT.prices.bach_consultation)||1000; }
  var sessions = Object.keys(AMOUNTS);
  var selSession=sessions[0], selDay=null, selTime=null;
  // Build tabs
  var tabsEl=document.getElementById('stabs');
  sessions.forEach(function(s){
    var b=document.createElement('button');
    b.className='stab'+(s===selSession?' active':'');
    b.textContent=s; b.onclick=function(){
      selSession=s; selDay=null; selTime=null;
      document.querySelectorAll('.stab').forEach(function(x){x.className='stab'});
      b.className='stab active';
      renderDays(); renderSlots();
      document.getElementById('bconfirm').className='booking-confirm';
    };
    tabsEl.appendChild(b);
  });
  // Build week strip (next 7 days from today)
  function renderDays(){
    var ws=document.getElementById('week-strip'); ws.innerHTML='';
    var DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var today=new Date();
    for(var i=0;i<7;i++){
      var d=new Date(today); d.setDate(today.getDate()+i);
      var dname=DAYS[d.getDay()];
      var avail=SLOTS.hasOwnProperty(dname);
      var btn=document.createElement('div');
      btn.className='day-btn'+(avail?'':' disabled')+(selDay&&selDay.toDateString()===d.toDateString()?' selected':'');
      btn.innerHTML='<div class="dname">'+dname+'</div><div class="dnum">'+d.getDate()+'</div><div style="font-size:.7rem;color:inherit;opacity:.75">'+MONTHS[d.getMonth()]+'</div>';
      (function(date,available){
        btn.onclick=function(){
          if(!available) return;
          selDay=date; selTime=null;
          renderDays(); renderSlots();
          document.getElementById('bconfirm').className='booking-confirm';
        };
      })(d,avail);
      ws.appendChild(btn);
    }
  }
  function renderSlots(){
    var sg=document.getElementById('slots-grid');
    var sl=document.getElementById('slots-label');
    sg.innerHTML='';
    if(!selDay){ sl.style.display='none'; return; }
    var DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var dname=DAYS[selDay.getDay()];
    var times=SLOTS[dname]||[];
    sl.style.display='block';
    sl.textContent='Available times — '+selDay.toDateString();
    times.forEach(function(t){
      var s=document.createElement('div');
      s.className='slot'+(t===selTime?' selected':'');
      s.textContent=t;
      s.onclick=function(){
        selTime=t; renderSlots();
        if(window.AS) AS.track('slot_selected',{label:selSession});
        showConfirm();
      };
      sg.appendChild(s);
    });
  }
  function showConfirm(){
    if(!selDay||!selTime) return;
    var MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var ds=DAYS[selDay.getDay()]+', '+selDay.getDate()+' '+MONTHS[selDay.getMonth()];
    document.getElementById('confirm-text').textContent=
      selSession+' — '+ds+' at '+selTime+' IST';
    setStatus('',true);
    document.getElementById('bconfirm').className='booking-confirm show';
  }

  // ── Razorpay Standard Checkout ────────────────────────────────────────────
  function setPayBtnState(busy){
    var b=document.getElementById('pay-btn');
    b.disabled=busy;
    b.innerHTML=busy?'Processing…':'Pay <span data-price="bach_consultation">'+AS.money(currentPrice())+'</span> &amp; Confirm →';
  }
  function setStatus(msg,ok){
    var el=document.getElementById('pay-status');
    el.textContent=msg;
    el.style.color=ok?'#2E7D32':'#C62828';
  }
  function payNow(){
    if(!selDay||!selTime) return;
    if(window.AS) AS.track('pay_click',{value:currentPrice()});
    setPayBtnState(true); setStatus('',true);
    fetch('/.netlify/functions/create-order',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({service:'bach_consultation',slot:document.getElementById('confirm-text').textContent,receipt:'bach_'+Date.now()})
    })
    .then(function(r){ if(!r.ok) return r.json().then(function(j){ var e=new Error((j&&j.error)||'order-failed'); e.server=true; throw e; },function(){ throw new Error('order-failed'); }); return r.json(); })
    .then(function(order){
      var rzp=new Razorpay({
        key:order.key_id||RAZORPAY_KEY_ID,
        amount:order.amount,
        currency:order.currency,
        name:'Antarshanti',
        description:selSession,
        order_id:order.order_id,
        theme:{color:'#B8406A'},
        handler:function(response){
          fetch('/.netlify/functions/verify-payment',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
              razorpay_order_id:response.razorpay_order_id,
              razorpay_payment_id:response.razorpay_payment_id,
              razorpay_signature:response.razorpay_signature
            })
          })
          .then(function(r){ return r.json(); })
          .then(function(result){
            setPayBtnState(false);
            if(result.success){
              if(window.AS) AS.track('payment_success',{value:currentPrice()});
              setStatus('✓ Payment confirmed. Please share a little about how you have been feeling on WhatsApp so Srikanth can prepare.',true);
            } else {
              setStatus('⚠ Payment could not be verified. WhatsApp Srikanth with payment ID '+response.razorpay_payment_id+'.',false);
            }
          })
          .catch(function(){
            setPayBtnState(false);
            setStatus('⚠ Could not verify payment. WhatsApp Srikanth with payment ID '+response.razorpay_payment_id+'.',false);
          });
        },
        modal:{ondismiss:function(){ setPayBtnState(false); setStatus('Payment cancelled.',false); }}
      });
      rzp.on('payment.failed',function(resp){
        setPayBtnState(false);
        setStatus('⚠ Payment failed: '+resp.error.description,false);
      });
      rzp.open();
    })
    .catch(function(err){
      setPayBtnState(false);
      setStatus(err&&err.server&&err.message!=='order-failed'?('⚠ '+err.message):'⚠ Could not start payment. Please try again, or WhatsApp Srikanth.',false);
    });
  }
  document.getElementById('pay-btn').addEventListener('click',payNow);
  renderDays(); renderSlots();
})();
</script>
      </div>
    </div>
  </div>
</section>

