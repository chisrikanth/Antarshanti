</section>

<section>
  <div class="wrap">
    <div style="display:grid;grid-template-columns:1.1fr 1fr;gap:32px;align-items:start" class="two-col">
      <div>
        <div class="eyebrow" style="color:var(--lotus);margin-bottom:10px">{{ c.who.eyebrow }}</div>
        <h2 style="font-size:clamp(1.7rem,3vw,2.2rem);margin-bottom:18px">{{ c.who.title }}</h2>
        <div style="display:flex;flex-direction:column;gap:8px">
          {% for it in c.who.items %}<div style="background:var(--card);border:1px solid var(--line);border-left:3px solid var(--lotus);border-radius:10px;padding:12px 16px;font-size:.96rem;color:var(--body)">{{ it }}</div>{% endfor %}
        </div>
      </div>
      <div>
<div class="booking-box" id="booking-widget">
  <div class="booking-header" style="background:var(--lotus)">
    <h3>{{ b.headerTitle }}</h3>
    <p>{{ b.headerSub }}</p>
  </div>
  <div class="booking-body">
    <div class="session-tabs" id="stabs"></div>
    <div class="slots-label">{{ b.selectDate }}</div>
    <div class="week-nav"><button type="button" id="wk-prev" class="wk-btn" aria-label="{{ b.prevAria }}">{{ b.prevWeek }}</button><span id="wk-label" class="wk-label"></span><button type="button" id="wk-next" class="wk-btn" aria-label="{{ b.nextAria }}">{{ b.nextWeek }}</button></div>
    <div class="week-strip" id="week-strip"></div>
    <div class="slots-label" id="slots-label" style="display:none">{{ b.times }}</div>
    <div class="slots-grid" id="slots-grid"></div>
    <div class="booking-confirm" id="bconfirm">
      <p style="font-weight:700;color:var(--ink);font-size:.97rem;margin-bottom:8px">
        ✦ <span id="confirm-text"></span>
      </p>
      <p style="font-size:.88rem;color:var(--body);margin-bottom:10px">{{ k.intro | replace('{price}', P) | safe }}</p>
      <div id="pay-status" style="font-size:.85rem;margin-bottom:10px;min-height:1.2em"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button id="pay-btn" class="btn btn-gold btn-sm" type="button">{{ k.payBtn | replace('{price}', P) | safe }}</button>
        <a id="wa-btn" class="btn btn-wa btn-sm" href="https://wa.me/919985133161?text={{ k.waMsgFirst | urlencode }}" target="_blank">{{ t.chrome.whatsappSrikanth }}</a>
      </div>
    </div>
    <div class="availability-note">{{ b.availNote }}</div>
    <p class="med-note">{{ k.medNote }}</p>
  </div>
</div>
<script src="/assets/booking.js"></script>
<script>var T = {{ b | dump | safe }}, K = {{ k | dump | safe }}, LANG = '{{ lang.code }}', WEEKLY = {{ weeklySlots | dump | safe }};</script>
{% raw %}<script>
(function(){
  ASBook.setT(T,LANG);
  var SLOTS = WEEKLY;   // built-in weekly fallback (src/_data/weeklySlots.json); the live calendar and database override it
  // ── Razorpay. Key ID is public and safe here. The SECRET goes only in
  //    Netlify env vars (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET). ───────────
  var RAZORPAY_KEY_ID = "rzp_live_TZpURxGvndampZ";  // live Key ID (public); the secret stays in Netlify
  var SESSION_EN = "Bach Flower Consultation";  // English name sent to Razorpay; the PRICE is set on the server (services table)
  function currentPrice(){ return (window.AS_CONTENT&&AS_CONTENT.prices&&AS_CONTENT.prices.bach_consultation)||1000; }
  var sessions = [K.tabName];
  var selSession=sessions[0], selDay=null, selTime=null, slotText='';
  var tabsEl=document.getElementById('stabs');
  sessions.forEach(function(s){
    var b=document.createElement('button');
    b.className='stab'+(s===selSession?' active':'');
    b.textContent=s; b.onclick=function(){
      selSession=s; selDay=null; selTime=null;
      document.querySelectorAll('.stab').forEach(function(x){x.className='stab'});
      b.className='stab active';
      renderDays(); renderSlots();
      document.getElementById('bconfirm').className='booking-confirm';
    };
    tabsEl.appendChild(b);
  });
  var weekOffset=0, MAX_WEEKS=6;
  function weekLabel(){
    var a=new Date(); a.setDate(a.getDate()+weekOffset*7); var b=new Date(a); b.setDate(a.getDate()+6);
    document.getElementById('wk-label').textContent=a.getDate()+' '+ASBook.monthName(a)+' – '+b.getDate()+' '+ASBook.monthName(b);
    document.getElementById('wk-prev').disabled=weekOffset===0;
    document.getElementById('wk-next').disabled=weekOffset>=MAX_WEEKS-1;
  }
  function gotoWeek(n){
    weekOffset=Math.max(0,Math.min(MAX_WEEKS-1,n)); selDay=null; selTime=null;
    document.getElementById('bconfirm').className='booking-confirm';
    renderDays(); renderSlots();
  }
  function renderDays(){
    var ws=document.getElementById('week-strip'); ws.innerHTML=''; weekLabel();
    var today=new Date();
    for(var i=0;i<7;i++){
      var d=new Date(today); d.setDate(today.getDate()+weekOffset*7+i);
      var avail=ASBook.dayHasFree(d,ASBook.timesFor(d,SLOTS));
      var btn=document.createElement('div');
      btn.className='day-btn'+(avail?'':' disabled')+(selDay&&selDay.toDateString()===d.toDateString()?' selected':'');
      btn.innerHTML='<div class="dname">'+ASBook.dayName(d)+'</div><div class="dnum">'+d.getDate()+'</div><div style="font-size:.7rem;color:inherit;opacity:.75">'+ASBook.monthName(d)+'</div>';
      (function(date,available){
        btn.onclick=function(){
          if(!available) return;
          selDay=date; selTime=null;
          renderDays(); renderSlots();
          document.getElementById('bconfirm').className='booking-confirm';
        };
      })(d,avail);
      ws.appendChild(btn);
    }
    if(!ws.querySelector('.day-btn:not(.disabled)')){
      var n=document.createElement('p'); n.style.cssText='font-size:.86rem;color:var(--dim);margin:10px 0 0;width:100%';
      var nextBtn='<button type="button" id="try-next-week" style="background:none;border:0;padding:0;font:inherit;color:#A04F14;text-decoration:underline;cursor:pointer">'+T.nextLink+'</button>';
      var waLnk='<a href="https://wa.me/919985133161?text='+encodeURIComponent(T.noTimesWaMsg)+'" target="_blank" rel="noopener" style="text-decoration:underline">'+T.waLink+'</a>';
      n.innerHTML=ASBook.fmt(T.noTimes,{next:nextBtn,wa:waLnk});
      ws.appendChild(n);
      var tn=document.getElementById('try-next-week'); if(tn) tn.onclick=function(){ gotoWeek(weekOffset+1); };
    }
  }
  function renderSlots(){
    var sg=document.getElementById('slots-grid');
    var sl=document.getElementById('slots-label');
    sg.innerHTML='';
    if(!selDay){ sl.style.display='none'; return; }
    var times=ASBook.timesFor(selDay,SLOTS);
    sl.style.display='block';
    sl.textContent=ASBook.fmt(T.timesFor,{date:ASBook.dateLabel(selDay)});
    times.forEach(function(t){
      var s=document.createElement('div');
      var st=ASBook.state(selDay,t);
      s.className='slot'+(t===selTime?' selected':'')+(st!=='free'?' taken':'');
      if(st==='taken') s.title=T.taken;
      s.textContent=ASBook.timeLabel(t);
      s.onclick=st!=='free'?null:function(){
        selTime=t; renderSlots();
        if(window.AS) AS.track('slot_selected',{label:SESSION_EN});
        showConfirm();
      };
      sg.appendChild(s);
    });
  }
  function showConfirm(){
    if(!selDay||!selTime) return;
    slotText=ASBook.fmt(T.at,{date:ASBook.dateLabel(selDay),time:ASBook.timeLabel(selTime)});
    document.getElementById('confirm-text').textContent=ASBook.fmt(T.confirmLine,{session:selSession,slot:slotText});
    setStatus('',true);
    document.getElementById('bconfirm').className='booking-confirm show';
  }

  // ── Razorpay Standard Checkout ────────────────────────────────────────────
  function payLabel(){ return ASBook.fmt(K.payBtn,{price:'<span data-price="bach_consultation">'+AS.money(currentPrice())+'</span>'}); }
  function setPayBtnState(busy){
    var b=document.getElementById('pay-btn');
    b.disabled=busy;
    b.innerHTML=busy?K.processing:payLabel();
  }
  function setStatus(msg,ok){
    var el=document.getElementById('pay-status');
    el.textContent=msg;
    el.style.color=ok?'#2E7D32':'#C62828';
  }
  function payNow(){
    if(!selDay||!selTime) return;
    if(window.AS) AS.track('pay_click',{value:currentPrice()});
    setPayBtnState(true); setStatus('',true);
    fetch('/.netlify/functions/create-order',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({service:'bach_consultation',slot:SESSION_EN+' — '+slotText,slot_start:ASBook.iso(selDay,selTime),receipt:'bach_'+Date.now()})
    })
    .then(function(r){ if(!r.ok) return r.json().then(function(j){ var e=new Error((j&&j.error)||'order-failed'); e.server=true; e.j=j; e.status=r.status; throw e; },function(){ throw new Error('order-failed'); }); return r.json(); })
    .then(function(order){
      var rzp=new Razorpay({
        key:order.key_id||RAZORPAY_KEY_ID,
        amount:order.amount,
        currency:order.currency,
        name:'Antarshanti',
        description:SESSION_EN,
        order_id:order.order_id,
        theme:{color:'#B8406A'},
        handler:function(response){
          fetch('/.netlify/functions/verify-payment',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
              razorpay_order_id:response.razorpay_order_id,
              razorpay_payment_id:response.razorpay_payment_id,
              razorpay_signature:response.razorpay_signature
            })
          })
          .then(function(r){ return r.json(); })
          .then(function(result){
            setPayBtnState(false);
            if(result.success){
              if(window.AS) AS.track('payment_success',{value:currentPrice()});
              setStatus(K.payOk,true);
            } else {
              setStatus(ASBook.fmt(K.payUnverified,{id:response.razorpay_payment_id}),false);
            }
          })
          .catch(function(){
            setPayBtnState(false);
            setStatus(ASBook.fmt(K.payVerifyErr,{id:response.razorpay_payment_id}),false);
          });
        },
        modal:{ondismiss:function(){ setPayBtnState(false); setStatus(K.cancelled,false); }}
      });
      rzp.on('payment.failed',function(resp){
        setPayBtnState(false);
        setStatus(ASBook.fmt(K.failedMsg,{reason:resp.error.description}),false);
      });
      rzp.open();
    })
    .catch(function(err){
      setPayBtnState(false);
      if(err&&err.status===409){ selTime=null; document.getElementById('bconfirm').className='booking-confirm'; ASBook.load().then(function(d){ if(d&&d.rules){ SLOTS=ASBook.slotsFromRules(d.rules);} renderDays(); renderSlots(); }); }
      var em=err&&err.server&&err.message!=='order-failed'?ASBook.err(err.j):null; setStatus(em?('⚠ '+em):K.startFail,false);
    });
  }
  document.getElementById('pay-btn').addEventListener('click',payNow);
  document.getElementById('wk-prev').addEventListener('click',function(){ gotoWeek(weekOffset-1); });
  document.getElementById('wk-next').addEventListener('click',function(){ gotoWeek(weekOffset+1); });
  renderDays(); renderSlots();
  ASBook.load().then(function(d){ if(d&&d.rules){ SLOTS=ASBook.slotsFromRules(d.rules); } renderDays(); renderSlots(); });
})();
</script>{% endraw %}
      </div>
    </div>
  </div>
</section>

